  "aggregate_revenue": {
    "title": "AGGREGATE: revenue and visits per doctor (GROUP BY ... HAVING)",
    "sql": "select d.full_name as doctor, dp.specialization, count(a.id) as appointments, count(*) filter (where a.status = 'completed') as completed, coalesce(sum(pay.amount) filter (where pay.status = 'paid'), 0) as revenue_inr from users d join doctor_profiles dp on dp.user_id = d.id join appointments a on a.doctor_id = d.id left join payments pay on pay.appointment_id = a.id group by d.full_name, dp.specialization having count(a.id) >= 2 order by revenue_inr desc, appointments desc",
