# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_string
ADMIN_REGISTRATION_KEY=replace_with_secure_admin_passcode

# Database (Prisma ORM). Supabase dashboard -> Connect -> "Session pooler" URI.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Supabase (file storage + email/password auth)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_ANON_KEY=replace_with_anon_public_key

# Ethereum / Blockchain
# Set to "true" to anchor report/prescription hashes on-chain (needs the three values below).
# Local chain: SEPOLIA_RPC_URL=http://127.0.0.1:8545, a Hardhat test account key, and
# `npm --prefix contracts run setup:local` fills in AUDIT_CONTRACT_ADDRESS.
BLOCKCHAIN_ENABLED=false
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
AUDIT_CONTRACT_ADDRESS=0xYourDeployedContractAddress
AUDIT_SIGNER_PRIVATE_KEY=replace_with_backend_signer_private_key

# AI report summaries. AI_PROVIDER is one of:
#   ollama            - local Ollama model (default)
#   openai-compatible - a hosted chat API in the OpenAI format; free with Groq (console.groq.com)
#   claude            - the Anthropic API (paid)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_CHAT_MODEL=qwen2.5:1.5b-instruct
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# OpenAI (not used by the current backend; kept for ai/rag_demo.py and the backup service)
OPENAI_API_KEY=sk-replace_me
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:3000
