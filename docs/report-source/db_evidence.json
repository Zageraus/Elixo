  "join_appointments": {
    "title": "JOIN: appointments with patient, doctor, specialization and payment",
    "sql": "select p.full_name as patient, d.full_name as doctor, dp.specialization, to_char(a.scheduled_at at time zone 'Asia/Kolkata','DD Mon YYYY HH24:MI') as scheduled_ist, a.status::text as status, coalesce(pay.status::text, '-') as payment from appointments a join users p on p.id = a.patient_id join users d on d.id = a.doctor_id left join doctor_profiles dp on dp.user_id = d.id left join payments pay on pay.appointment_id = a.id where a.scheduled_at between '2026-09-01' and '2026-12-31' order by a.scheduled_at desc limit 8",
