  "demo_atomicity": [
    [
      "SELECT count(*) FROM prescriptions",
      "10"
    ],
    [
      "BEGIN; CALL sp_create_prescription(... items: Paracetamol (3 days), Bad line (0 days) ...)",
      "ERROR: new row for relation \"prescription_items\" violates check constraint \"prescription_items_duration_days_check\""
    ],
    [
      "(transaction aborted)",
      "ROLLBACK"
    ],
    [
      "SELECT count(*) FROM prescriptions",
      "10   (unchanged: the header row was rolled back with the bad item)"
    ]
  ],
  "demo_trigger": [
    [
      "BEGIN; SELECT set_config('app.current_user_id', <admin id>, true)",
      "acting user recorded for the audit trigger"
    ],
    [
      "SELECT status, payment FROM appointment of Sneha Kulkarni",
      "confirmed | paid"
    ],
    [
      "UPDATE appointments SET status = 'cancelled' WHERE id = <that appointment>",
      "UPDATE 1   -> trg_refund_on_cancel, trg_notify_appointment, trg_audit_appointments fire"
    ],
    [
      "SELECT status, refunded_at IS NOT NULL FROM payments WHERE appointment_id = <it>",
      "refunded | true"
    ],
    [
      "SELECT action, entity_type, acted_by FROM audit_logs (newest for it)",
      "UPDATE | appointments | Alice Admin"
    ],
    [
      "ROLLBACK",
      "demo discarded: appointment and payment are unchanged"
